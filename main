<script>
// ============ 設定區 ============
const SHEET_WEBAPP_URL = "https://script.google.com/macros/s/AKfycbwQZ233hg9vuEvqWI1d60kj5q7K7DTi_BwaQGHZ_Br0cdLaDtbGLpGl3NWX2MhYUyNgOw/exec"; // 已填入你部署的網址

// 安全性權杖:不寫死在檔案裡,改成存在「你這台裝置瀏覽器」的 localStorage。
// 這樣就算這個 HTML 檔案被公開發布(例如放上 GitHub Pages),檔案本身也不含任何機密——
// 權杖只存在於你自己輸入過的瀏覽器裡,其他人打開同一個網址不會自動拿到你的權杖。
let SECRET_TOKEN = localStorage.getItem('assetDashboardToken') || '';

function promptForToken(){
  const input = prompt('請輸入你的安全性權杖(跟 Apps Script 指令碼屬性裡的 SECRET_TOKEN 完全一致):', SECRET_TOKEN);
  if(input !== null){
    SECRET_TOKEN = input.trim();
    localStorage.setItem('assetDashboardToken', SECRET_TOKEN);
    updateTokenBanner();
    loadAll();
  }
}

function updateTokenBanner(){
  const el = document.getElementById('tokenBanner');
  if(!el) return;
  if(!SECRET_TOKEN){
    el.style.display = 'flex';
    el.innerHTML = `⚠️ 尚未設定安全性權杖,無法讀取真實資料。<button class="row-btn save" onclick="promptForToken()">設定權杖</button>`;
  } else {
    el.style.display = 'none';
  }
}

const CATEGORY_TREE = {
  "股票": ["美股核心","台股核心","主題衛星","區域型"],
  "債券": ["公債","公司債"],
  "現金": ["現金"]
};

const DEFAULT_TARGETS = {
  "美股核心": 0.35, "台股核心": 0.21, "主題衛星": 0.105, "區域型": 0.035,
  "公債": 0.15, "公司債": 0.05,
  "現金": 0.10
};

// 風險油門(時速)三個錨點,中間用線性內插自動算出目標%
// 時速70 = 你原本設定的 股票70%/債券20%/現金10%(等同 DEFAULT_TARGETS)
const THROTTLE_ANCHORS = {
  10:  { "美股核心":0.20, "台股核心":0.05, "主題衛星":0.00, "區域型":0.05, "公債":0.50, "公司債":0.10, "現金":0.10 },
  70:  { ...DEFAULT_TARGETS },
  100: { "美股核心":0.45, "台股核心":0.25, "主題衛星":0.15, "區域型":0.05, "公債":0.05, "公司債":0.00, "現金":0.05 }
};

function computeThrottleTargets(speed){
  speed = Math.max(10, Math.min(100, Number(speed)));
  let lo=10, hi=70;
  if(speed>70){ lo=70; hi=100; }
  const t = (speed-lo)/(hi-lo);
  const a = THROTTLE_ANCHORS[lo], b = THROTTLE_ANCHORS[hi];
  const result = {};
  Object.keys(DEFAULT_TARGETS).forEach(k=>{
    result[k] = a[k] + (b[k]-a[k])*t;
  });
  return result;
}

function throttleDescription(speed){
  if(speed<=25) return '保守:公債+AAA公司債為主,股票偏美股/台股大盤';
  if(speed<70) return '偏保守到均衡之間,逐步加碼股票、降低債券比重';
  if(speed===70) return '均衡(等於原本 股票70%/債券20%/現金10% 設定)';
  if(speed<90) return '偏積極:股票與衛星部位增加,債券持續降低';
  return '積極:股票與衛星部位大,債券降到最低 —— 建議搭配槓桿工具(如2倍槓桿ETF)增加曝險,而不是把現金也歸零';
}

function onThrottleInput(speed){
  speed = Number(speed);
  document.getElementById('throttleReadout').textContent = '時速 '+speed;
  document.getElementById('throttleDesc').textContent = throttleDescription(speed);
  targets = computeThrottleTargets(speed);
  saveTargets();
  render();
}

let targets = {...DEFAULT_TARGETS};
let holdings = []; // {ticker,category,sub,qty,cost,price,value,returnPct}
let cashValue = 0;
let monthlyCashflow = []; // {month, income, expense, net, cumulative}
let assetSnapshots = []; // {date, total, stock, bond, cash} 手動記錄的每月資產快照
let transactions = []; // {row, date, ticker, category, sub, qty} 交易登記分頁的原始列,row是Sheet列號(供編輯/刪除用)
let txEditingRow = null; // 目前正在編輯中的列號

const APPS_SCRIPT_CODE = `// 安全性權杖存放在「指令碼屬性」,不寫死在程式碼裡,避免只要有人看到這份程式碼就外洩。
// 設定方式:Apps Script 編輯器左側齒輪圖示「專案設定」→ 捲到底部「指令碼屬性」→ 新增屬性
// 屬性名稱填:SECRET_TOKEN,值填一組你自訂的隨機字串(20字元以上),跟網頁裡的 SECRET_TOKEN 完全一致。

function getSecretToken_() {
  return PropertiesService.getScriptProperties().getProperty('SECRET_TOKEN') || '';
}

function checkToken_(token) {
  var secret = getSecretToken_();
  return !!secret && token === secret;
}

// 防止公式注入:若字串以 = + - @ 開頭,前面補一個單引號讓 Sheet 當純文字處理
function sanitizeCell_(v) {
  if (typeof v === 'string' && /^[=+\\-@]/.test(v)) {
    return "'" + v;
  }
  return v;
}

// 驗證日期字串格式(yyyy-mm-dd),避免繞過網頁直接呼叫API塞入奇怪的日期
function validDate_(d) {
  return typeof d === 'string' && /^\\d{4}-\\d{2}-\\d{2}$/.test(d);
}

function doGet(e) {
  if (!checkToken_(e.parameter.token)) {
    return ContentService.createTextOutput(JSON.stringify({error: 'unauthorized'}))
      .setMimeType(ContentService.MimeType.JSON);
  }

  var ss = SpreadsheetApp.getActiveSpreadsheet();

  // 讀取資產總表(股票/債券持股)
  var assetSheet = ss.getSheetByName('資產總表');
  var holdings = [];
  if (assetSheet) {
    var data = assetSheet.getDataRange().getValues();
    for (var i = 1; i < data.length; i++) {
      var row = data[i];
      if (!row[0]) continue;
      holdings.push({
        ticker: row[0], category: row[1], sub: row[2],
        qty: row[3], cost: row[4], price: row[5],
        value: row[6], pnl: row[7], returnPct: row[8]
      });
    }
  }

  // 讀取登記紀錄(現金帳戶),取最新一列加總
  var cashSheet = ss.getSheetByName('登記紀錄');
  var cashTotal = 0;
  if (cashSheet) {
    var cdata = cashSheet.getDataRange().getValues();
    if (cdata.length > 1) {
      var lastRow = cdata[cdata.length - 1];
      for (var j = 1; j < lastRow.length; j++) {
        cashTotal += Number(lastRow[j]) || 0;
      }
    }
  }

  // 讀取月度現金流總表
  var cfSheet = ss.getSheetByName('月度現金流總表');
  var monthlyCashflow = [];
  if (cfSheet) {
    var cfData = cfSheet.getDataRange().getValues();
    for (var k = 1; k < cfData.length; k++) {
      var cfRow = cfData[k];
      if (!cfRow[0]) continue;
      monthlyCashflow.push({
        month: cfRow[0], income: cfRow[1], expense: cfRow[2],
        net: cfRow[3], cumulative: cfRow[4]
      });
    }
  }

  // 讀取資產快照歷史(手動記錄的每月總資產,用來畫真實成長曲線)
  var snapSheet = ss.getSheetByName('資產快照歷史');
  var assetSnapshots = [];
  if (snapSheet) {
    var snapData = snapSheet.getDataRange().getValues();
    for (var s = 1; s < snapData.length; s++) {
      var snapRow = snapData[s];
      if (!snapRow[0]) continue;
      var d = snapRow[0];
      var dateStr = (d instanceof Date) ? Utilities.formatDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd') : String(d);
      assetSnapshots.push({
        date: dateStr, total: snapRow[1], stock: snapRow[2], bond: snapRow[3], cash: snapRow[4]
      });
    }
  }

  // 讀取交易登記的原始列(含Sheet列號,供網頁編輯/刪除使用)
  var txSheet = ss.getSheetByName('交易登記');
  var transactions = [];
  if (txSheet) {
    var txData = txSheet.getDataRange().getValues();
    for (var t = 1; t < txData.length; t++) {
      var txRow = txData[t];
      if (!txRow[2]) continue; // C欄代號空白代表這列沒有資料
      var txDate = txRow[1];
      var txDateStr = (txDate instanceof Date) ? Utilities.formatDate(txDate, Session.getScriptTimeZone(), 'yyyy-MM-dd') : String(txDate);
      transactions.push({
        row: t + 1, // 實際 Sheet 列號(1-indexed,+1因為t從1開始對應第2列)
        date: txDateStr, ticker: txRow[2], category: txRow[3], sub: txRow[4], qty: txRow[5]
      });
    }
  }

  var result = { holdings: holdings, cash: cashTotal, monthlyCashflow: monthlyCashflow, assetSnapshots: assetSnapshots, transactions: transactions };
  return ContentService.createTextOutput(JSON.stringify(result))
    .setMimeType(ContentService.MimeType.JSON);
}

var CATEGORY_TREE_ = {
  '股票': ['美股核心','台股核心','主題衛星','區域型'],
  '債券': ['公債','公司債'],
  '現金': ['現金']
};

function validateTxInput_(ticker, qty, category, sub, date) {
  var validCategories = ['股票','債券','現金'];
  if (!/^[A-Za-z0-9.\-]{1,15}$/.test(ticker)) return 'invalid ticker';
  if (isNaN(qty) || qty <= 0 || qty > 1000000) return 'invalid qty';
  if (validCategories.indexOf(category) === -1) return 'invalid category';
  if (!CATEGORY_TREE_[category] || CATEGORY_TREE_[category].indexOf(sub) === -1) return 'invalid sub';
  if (!validDate_(date)) return 'invalid date';
  return null;
}

function doPost(e) {
  var body = JSON.parse(e.postData.contents);

  if (!checkToken_(body.token)) {
    return ContentService.createTextOutput(JSON.stringify({error: 'unauthorized'}))
      .setMimeType(ContentService.MimeType.JSON);
  }

  var ss = SpreadsheetApp.getActiveSpreadsheet();

  if (body.type === 'transaction') {
    // 驗證輸入格式,拒絕不合理的資料
    var ticker = String(body.ticker || '');
    var qty = Number(body.qty);
    var err = validateTxInput_(ticker, qty, body.category, body.sub, body.date);
    if (err) {
      return ContentService.createTextOutput(JSON.stringify({error: err}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    var sheet = ss.getSheetByName('交易登記');
    sheet.appendRow([
      new Date(), sanitizeCell_(body.date), sanitizeCell_(ticker),
      sanitizeCell_(body.category), sanitizeCell_(body.sub), qty
    ]);
    // G,H 欄(買入價/成本)已在該列的公式範本自動計算,若新列沒公式需手動下拉填滿一次
  } else if (body.type === 'updateTransaction') {
    // 編輯既有交易列(B~F欄),不動A欄時間戳記,也不動G/H公式
    var uTicker = String(body.ticker || '').toUpperCase();
    var uQty = Number(body.qty);
    var uErr = validateTxInput_(uTicker, uQty, body.category, body.sub, body.date);
    if (uErr) {
      return ContentService.createTextOutput(JSON.stringify({error: uErr}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    var txSheetEdit = ss.getSheetByName('交易登記');
    var row = Number(body.row);
    if (isNaN(row) || row < 2 || row > txSheetEdit.getLastRow()) {
      return ContentService.createTextOutput(JSON.stringify({error: 'invalid row'}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    txSheetEdit.getRange(row, 2, 1, 5).setValues([[
      sanitizeCell_(body.date), sanitizeCell_(uTicker),
      sanitizeCell_(body.category), sanitizeCell_(body.sub), uQty
    ]]);
  } else if (body.type === 'deleteTransaction') {
    var txSheetDel = ss.getSheetByName('交易登記');
    var delRow = Number(body.row);
    if (isNaN(delRow) || delRow < 2 || delRow > txSheetDel.getLastRow()) {
      return ContentService.createTextOutput(JSON.stringify({error: 'invalid row'}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    txSheetDel.deleteRow(delRow);
  } else if (body.type === 'snapshot') {
    // 記錄本月資產快照,驗證都是合理數字才寫入
    var total = Number(body.total), stock = Number(body.stock), bond = Number(body.bond), cash = Number(body.cash);
    if (!validDate_(body.date)) {
      return ContentService.createTextOutput(JSON.stringify({error:'invalid date'}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    if ([total, stock, bond, cash].some(function(v){ return isNaN(v) || v < 0 || v > 1e12; })) {
      return ContentService.createTextOutput(JSON.stringify({error:'invalid snapshot values'}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    var snapSheet2 = ss.getSheetByName('資產快照歷史');
    snapSheet2.appendRow([sanitizeCell_(body.date), total, stock, bond, cash]);
  } else if (body.type === 'cashflowEntry') {
    // 記一筆收支(即時記帳),驗證類型與金額後寫入收支明細分頁
    var entryType = String(body.entryType || '');
    var amount = Number(body.amount);
    var categoryStr = String(body.category || '未分類').slice(0, 50);
    var noteStr = String(body.note || '').slice(0, 200);
    if (!validDate_(body.date)) {
      return ContentService.createTextOutput(JSON.stringify({error:'invalid date'}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    if (['收入','支出'].indexOf(entryType) === -1) {
      return ContentService.createTextOutput(JSON.stringify({error:'invalid entryType'}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    if (isNaN(amount) || amount <= 0 || amount > 10000000) {
      return ContentService.createTextOutput(JSON.stringify({error:'invalid amount'}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    var cfSheet2 = ss.getSheetByName('收支明細');
    var entryDateStr = String(body.date || '');
    var monthStr = entryDateStr.slice(0,7); // yyyy-mm,直接算好寫入,不用等公式往下拉
    cfSheet2.appendRow([
      sanitizeCell_(entryDateStr), entryType, sanitizeCell_(categoryStr),
      amount, sanitizeCell_(noteStr), monthStr
    ]);
  } else {
    // 沿用原本現金帳戶登記邏輯:寫入登記紀錄分頁,數字欄位一律轉為 Number 避免公式注入
    var cashSheet = ss.getSheetByName('登記紀錄');
    cashSheet.appendRow([
      sanitizeCell_(body.time),
      Number(body['國泰世華']) || 0, Number(body['LINEpay']) || 0,
      Number(body['紙鈔']) || 0, Number(body['中國信託']) || 0,
      Number(body['LINEBANK']) || 0, Number(body['IBKR']) || 0,
      Number(body['ETORO']) || 0
    ]);
  }

  return ContentService.createTextOutput(JSON.stringify({status:'ok'}))
    .setMimeType(ContentService.MimeType.JSON);
}`;

function escapeHtml(str){
  if(str===null||str===undefined) return '';
  return String(str)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

// 基本輸入驗證:代號只允許英數字、點、連字號,長度限制,避免公式注入字元(=+-@開頭)
function validTicker(t){
  return /^[A-Za-z0-9.\-]{1,15}$/.test(t) && !/^[=+\-@]/.test(t);
}
function validQty(q){
  const n = Number(q);
  return !isNaN(n) && n > 0 && n < 1000000;
}
function validDate(d){
  return /^\d{4}-\d{2}-\d{2}$/.test(d);
}

function fmtMoney(n){
  if(n===null||n===undefined||isNaN(n)) return '--';
  return n.toLocaleString('zh-TW',{maximumFractionDigits:0});
}
function fmtPct(n){
  if(n===null||n===undefined||isNaN(n)) return '--';
  return (n*100).toFixed(1)+'%';
}

function updateSubOptions(){
  const cat = document.getElementById('txCategory').value;
  const subSel = document.getElementById('txSub');
  subSel.innerHTML = '';
  CATEGORY_TREE[cat].forEach(s=>{
    const opt = document.createElement('option');
    opt.value = s; opt.textContent = s;
    subSel.appendChild(opt);
  });
}

async function submitTx(evt){
  evt.preventDefault();
  const statusEl = document.getElementById('txStatus');
  const dateVal = document.getElementById('txDate').value;
  const tickerVal = document.getElementById('txTicker').value.trim().toUpperCase();
  const qtyVal = document.getElementById('txQty').value;

  if(!validDate(dateVal)){
    statusEl.textContent = '交易日期格式不正確。';
    statusEl.style.color = 'var(--red)'; return false;
  }
  if(!validTicker(tickerVal)){
    statusEl.textContent = '代號只能是英數字、點或連字號(1-15字),且不能以 = + - @ 開頭。';
    statusEl.style.color = 'var(--red)'; return false;
  }
  if(!validQty(qtyVal)){
    statusEl.textContent = '數量必須是大於 0 的數字。';
    statusEl.style.color = 'var(--red)'; return false;
  }

  const payload = {
    type:'transaction',
    token: SECRET_TOKEN,
    date: dateVal,
    ticker: tickerVal,
    category: document.getElementById('txCategory').value,
    sub: document.getElementById('txSub').value,
    qty: qtyVal
  };
  if(!SHEET_WEBAPP_URL){
    statusEl.textContent = '尚未設定 Sheet 網址,請依下方教學部署 Apps Script。';
    statusEl.style.color = 'var(--red)';
    return false;
  }
  if(!SECRET_TOKEN){
    statusEl.textContent = '尚未設定安全性權杖(SECRET_TOKEN),請先設定再送出,避免任何人都能寫入你的資料。';
    statusEl.style.color = 'var(--red)';
    return false;
  }
  try{
    await fetch(SHEET_WEBAPP_URL, {
      method:'POST', mode:'no-cors',
      body: JSON.stringify(payload)
    });
    statusEl.textContent = '已送出登記(因跨網域限制無法100%確認寫入成功,建議偶爾回 Sheet 確認)';
    statusEl.style.color = 'var(--teal)';
    document.getElementById('txForm').reset();
    setTimeout(loadAll, 1500);
  }catch(err){
    statusEl.textContent = '送出失敗:'+err.message;
    statusEl.style.color = 'var(--red)';
  }
  return false;
}

const SUB_OPTIONS_ALL = ['美股核心','台股核心','主題衛星','區域型','公債','公司債','現金'];
const CATEGORY_OPTIONS_ALL = ['股票','債券','現金'];

function renderTxList(){
  const body = document.getElementById('txListBody');
  if(!transactions.length){
    body.innerHTML = '<tr><td colspan="6" class="chart-empty">尚無交易紀錄,或尚未設定 Sheet 網址。</td></tr>';
    return;
  }
  body.innerHTML = transactions.map(tx=>{
    const editing = txEditingRow === tx.row;
    if(!editing){
      return `<tr>
        <td>${escapeHtml(tx.date)}</td>
        <td class="name">${escapeHtml(tx.ticker)}</td>
        <td class="name">${escapeHtml(tx.category)}</td>
        <td class="name">${escapeHtml(tx.sub)}</td>
        <td>${escapeHtml(tx.qty)}</td>
        <td>
          <button class="row-btn save" style="background:var(--navy);" onclick="editTxRow(${tx.row})">編輯</button>
          <button class="row-btn delete" onclick="deleteTx(${tx.row})">刪除</button>
        </td>
      </tr>`;
    } else {
      const catOpts = CATEGORY_OPTIONS_ALL.map(c=>`<option value="${c}" ${c===tx.category?'selected':''}>${c}</option>`).join('');
      const subOpts = SUB_OPTIONS_ALL.map(s=>`<option value="${s}" ${s===tx.sub?'selected':''}>${s}</option>`).join('');
      return `<tr>
        <td><input class="tx-edit-input" type="date" id="edit-date-${tx.row}" value="${escapeHtml(tx.date)}"></td>
        <td><input class="tx-edit-input" type="text" id="edit-ticker-${tx.row}" value="${escapeHtml(tx.ticker)}"></td>
        <td><select class="tx-edit-select" id="edit-category-${tx.row}">${catOpts}</select></td>
        <td><select class="tx-edit-select" id="edit-sub-${tx.row}">${subOpts}</select></td>
        <td><input class="tx-edit-input" type="number" step="0.0001" id="edit-qty-${tx.row}" value="${tx.qty}"></td>
        <td>
          <button class="row-btn save" onclick="saveTxEdit(${tx.row})">儲存</button>
          <button class="row-btn cancel" onclick="cancelTxEdit()">取消</button>
        </td>
      </tr>`;
    }
  }).join('');
}

function editTxRow(row){
  txEditingRow = row;
  renderTxList();
}

function cancelTxEdit(){
  txEditingRow = null;
  renderTxList();
}

async function saveTxEdit(row){
  const statusEl = document.getElementById('txListStatus');
  const dateVal = document.getElementById('edit-date-'+row).value;
  const tickerVal = document.getElementById('edit-ticker-'+row).value.trim().toUpperCase();
  const categoryVal = document.getElementById('edit-category-'+row).value;
  const subVal = document.getElementById('edit-sub-'+row).value;
  const qtyVal = document.getElementById('edit-qty-'+row).value;

  if(!validDate(dateVal)){ statusEl.textContent='交易日期格式不正確。'; statusEl.style.color='var(--red)'; return; }
  if(!validTicker(tickerVal)){ statusEl.textContent='代號格式不正確(英數字/點/連字號,1-15字,不能以=+-@開頭)。'; statusEl.style.color='var(--red)'; return; }
  if(!validQty(qtyVal)){ statusEl.textContent='數量必須是大於0的數字。'; statusEl.style.color='var(--red)'; return; }
  if(!SHEET_WEBAPP_URL || !SECRET_TOKEN){ statusEl.textContent='尚未設定 Sheet 網址或安全性權杖。'; statusEl.style.color='var(--red)'; return; }

  const payload = {
    type:'updateTransaction', token:SECRET_TOKEN, row:row,
    date:dateVal, ticker:tickerVal, category:categoryVal, sub:subVal, qty:qtyVal
  };
  try{
    await fetch(SHEET_WEBAPP_URL, { method:'POST', mode:'no-cors', body: JSON.stringify(payload) });
    statusEl.textContent = '已送出修改(跨網域限制無法即時確認,稍後會自動重新整理)。';
    statusEl.style.color = 'var(--teal)';
    txEditingRow = null;
    setTimeout(loadAll, 1500);
  }catch(err){
    statusEl.textContent = '送出失敗:'+err.message;
    statusEl.style.color = 'var(--red)';
  }
}

async function deleteTx(row){
  const statusEl = document.getElementById('txListStatus');
  if(!SHEET_WEBAPP_URL || !SECRET_TOKEN){ statusEl.textContent='尚未設定 Sheet 網址或安全性權杖。'; statusEl.style.color='var(--red)'; return; }
  if(!confirm('確定要刪除這筆交易紀錄嗎?這個動作無法復原。')) return;

  const payload = { type:'deleteTransaction', token:SECRET_TOKEN, row:row };
  try{
    await fetch(SHEET_WEBAPP_URL, { method:'POST', mode:'no-cors', body: JSON.stringify(payload) });
    statusEl.textContent = '已送出刪除(跨網域限制無法即時確認,稍後會自動重新整理)。';
    statusEl.style.color = 'var(--teal)';
    setTimeout(loadAll, 1500);
  }catch(err){
    statusEl.textContent = '送出失敗:'+err.message;
    statusEl.style.color = 'var(--red)';
  }
}

function aggregateBySub(){
  const agg = {};
  Object.keys(targets).forEach(s=>agg[s]={value:0,category:null});
  holdings.forEach(h=>{
    if(!agg[h.sub]) agg[h.sub] = {value:0,category:h.category};
    agg[h.sub].value += Number(h.value)||0;
    agg[h.sub].category = h.category;
  });
  agg['現金'] = {value: cashValue, category:'現金'};
  return agg;
}

let totalAssetValueGlobal = 0;

function render(){
  const agg = aggregateBySub();
  const totalValue = Object.values(agg).reduce((s,a)=>s+a.value,0);
  totalAssetValueGlobal = totalValue;
  const totalCost = holdings.reduce((s,h)=>s+(Number(h.cost)||0),0) ; // 現金無成本概念
  const totalPnl = holdings.reduce((s,h)=>s+(Number(h.pnl)||0),0);
  const totalReturn = totalCost>0 ? totalPnl/totalCost : null;

  document.getElementById('totalValue').textContent = 'NT$'+fmtMoney(totalValue);
  document.getElementById('totalCost').textContent = 'NT$'+fmtMoney(totalCost)+'(不含現金)';
  const pnlEl = document.getElementById('totalPnl');
  pnlEl.textContent = (totalPnl>=0?'+':'')+'NT$'+fmtMoney(totalPnl);
  pnlEl.className = 'value ' + (totalPnl>=0?'pos':'neg');
  const retEl = document.getElementById('totalReturn');
  retEl.textContent = totalReturn!==null ? fmtPct(totalReturn) : '--';
  retEl.className = 'value ' + (totalReturn>=0?'pos':'neg');

  // 象限
  const quadGrid = document.getElementById('quadGrid');
  quadGrid.innerHTML = '';
  Object.keys(targets).forEach(sub=>{
    const a = agg[sub] || {value:0};
    const pct = totalValue>0 ? a.value/totalValue : 0;
    const tgt = targets[sub];
    const barPct = Math.min(pct/(Math.max(tgt,pct,0.001)*1.3)*100,100);
    const targetMarkPct = Math.min(tgt/(Math.max(tgt,pct,0.001)*1.3)*100,100);
    const diff = pct - tgt;
    const band = Math.min(0.05, tgt*0.25);
    let diffClass = 'diff-ok', diffLabel = '容許範圍內';
    if(diff > band){diffClass='diff-over'; diffLabel='超配 '+fmtPct(diff);}
    else if(diff < -band){diffClass='diff-under'; diffLabel='低配 '+fmtPct(-diff);}
    const targetValue = tgt*totalValue;

    const cell = document.createElement('div');
    cell.className = 'quad-cell';
    cell.innerHTML = `
      <div class="cat-label">${escapeHtml(a.category||'')}</div>
      <div class="sub-label">${escapeHtml(sub)}</div>
      <div class="pct-row"><span>目前 ${fmtPct(pct)}</span><span>目標 <input class="target-input" data-sub="${escapeHtml(sub)}" type="number" step="0.5" value="${(tgt*100).toFixed(1)}">%</span></div>
      <div class="pct-row" style="color:#9a927c; font-size:11px;"><span>NT$${fmtMoney(a.value)}</span><span>NT$${fmtMoney(targetValue)}</span></div>
      <div class="bar-track">
        <div class="bar-fill" style="width:${barPct}%"></div>
        <div class="bar-target-mark" style="left:${targetMarkPct}%"></div>
      </div>
      <span class="diff-tag ${diffClass}">${diffLabel}</span>
    `;
    quadGrid.appendChild(cell);
  });
  document.querySelectorAll('.target-input').forEach(inp=>{
    inp.addEventListener('change', async (e)=>{
      const sub = e.target.dataset.sub;
      const val = parseFloat(e.target.value)/100;
      if(!isNaN(val)){
        targets[sub] = val;
        await saveTargets();
        render();
      }
    });
  });

  // 再平衡表 —— 依《投資金律》5/25 法則:偏離目標超過 5 個百分點,或超過目標值的 25%(取較嚴格者)才需動作
  // 加碼/減碼金額 = 總資產 × 目標% − 目前金額(標準算法;5/25法則只是用來決定「要不要顯示為需要動作」,不影響金額計算方式)
  const rebalBody = document.getElementById('rebalBody');
  rebalBody.innerHTML = '';
  const actionItems = []; // 收集需要動作的細項,等一下渲染成上方的行動清單

  Object.keys(targets).forEach(sub=>{
    const a = agg[sub] || {value:0};
    const pct = totalValue>0 ? a.value/totalValue : 0;
    const tgt = targets[sub];
    const band = Math.min(0.05, tgt*0.25);
    const lower = tgt - band, upper = tgt + band;
    const breached = pct < lower || pct > upper;
    const targetValue = tgt * totalValue;
    const diffAmt = targetValue - a.value;
    const status = breached
      ? `<span class="action-needed">需要再平衡</span>`
      : `<span class="action-ok">容許範圍內</span>`;
    const action = !breached ? '暫不動作'
      : (diffAmt>0 ? `加碼 NT$${fmtMoney(diffAmt)}` : `減碼 NT$${fmtMoney(-diffAmt)}`);
    if(breached){
      actionItems.push({ sub, diffAmt });
    }
    const tr = document.createElement('tr');
    tr.innerHTML = `<td class="name">${escapeHtml(sub)}</td><td>NT$${fmtMoney(a.value)}</td><td>${fmtPct(pct)}</td><td>${fmtPct(tgt)}</td><td>${fmtPct(lower)}~${fmtPct(upper)}</td><td class="name">${status}</td><td class="name">${escapeHtml(action)}</td>`;
    rebalBody.appendChild(tr);
  });

  // 行動清單:只列出「需要再平衡」的細項,用市值算好的金額直接告訴你要加碼/減碼多少
  const rebalActionListEl = document.getElementById('rebalActionList');
  if(!actionItems.length){
    rebalActionListEl.innerHTML = `<div class="rebal-all-ok">✅ 目前所有細項都在容許範圍內,不需要任何動作。</div>`;
  } else {
    actionItems.sort((a,b)=>Math.abs(b.diffAmt)-Math.abs(a.diffAmt)); // 金額大的排前面,優先處理
    rebalActionListEl.innerHTML = actionItems.map(item=>{
      const isBuy = item.diffAmt > 0;
      return `<div class="rebal-action-item ${isBuy?'buy':'sell'}">
        <span class="ra-name">${isBuy?'🟢 加碼':'🔴 減碼'} ${escapeHtml(item.sub)}</span>
        <span class="ra-amount">NT$${fmtMoney(Math.abs(item.diffAmt))}</span>
      </div>`;
    }).join('');
  }

  // 持股明細
  const hBody = document.getElementById('holdingsBody');
  hBody.innerHTML = '';
  holdings.forEach(h=>{
    const tr = document.createElement('tr');
    const retClass = (h.returnPct>=0) ? 'pos':'neg';
    tr.innerHTML = `<td class="name">${escapeHtml(h.ticker)}</td><td class="name">${escapeHtml(h.sub)}</td><td>${escapeHtml(h.qty)}</td><td>${fmtMoney(h.cost)}</td><td>${fmtMoney(h.price)}</td><td>${fmtMoney(h.value)}</td><td style="color:${h.returnPct>=0?'#3a8f8c':'#b5533f'}">${fmtPct(h.returnPct)}</td>`;
    hBody.appendChild(tr);
  });
}

async function saveTargets(){
  try{ await window.storage.set('rebalance-targets', JSON.stringify(targets)); }catch(e){}
}
async function loadTargets(){
  try{
    const r = await window.storage.get('rebalance-targets');
    if(r && r.value) targets = {...DEFAULT_TARGETS, ...JSON.parse(r.value)};
  }catch(e){ /* 尚無儲存值,使用預設 */ }
}

function renderCashflow(){
  const summaryEl = document.getElementById('cashflowSummary');
  const cumEl = document.getElementById('cumulativeChart');
  const barEl = document.getElementById('netBarChart');

  if(!monthlyCashflow.length){
    summaryEl.innerHTML = '';
    cumEl.innerHTML = '<div class="chart-empty">尚無資料。請依下方教學把 Money Manager 匯出的收支資料貼進「收支明細」分頁。</div>';
    barEl.innerHTML = '';
    return;
  }

  const latest = monthlyCashflow[monthlyCashflow.length-1];
  summaryEl.innerHTML = `
    <div class="summary-box"><div class="label">本月收入(${escapeHtml(latest.month)})</div><div class="value small pos">+NT$${fmtMoney(latest.income)}</div></div>
    <div class="summary-box"><div class="label">本月支出</div><div class="value small neg">-NT$${fmtMoney(latest.expense)}</div></div>
    <div class="summary-box"><div class="label">本月結餘</div><div class="value small ${latest.net>=0?'pos':'neg'}">${latest.net>=0?'+':''}NT$${fmtMoney(latest.net)}</div></div>
    <div class="summary-box"><div class="label">累積結餘</div><div class="value ${latest.cumulative>=0?'pos':'neg'}">NT$${fmtMoney(latest.cumulative)}</div></div>
  `;

  // ---- 累積結餘趨勢(折線圖) ----
  const W = 760, H = 180, padL = 55, padR = 15, padT = 15, padB = 25;
  const cumVals = monthlyCashflow.map(m=>m.cumulative);
  const cumMin = Math.min(0, ...cumVals), cumMax = Math.max(0, ...cumVals);
  const cumRange = (cumMax - cumMin) || 1;
  const n = monthlyCashflow.length;
  const xStep = n>1 ? (W-padL-padR)/(n-1) : 0;
  const yFor = v => padT + (H-padT-padB) * (1 - (v-cumMin)/cumRange);
  const xFor = i => padL + xStep*i;

  let linePoints = monthlyCashflow.map((m,i)=>`${xFor(i)},${yFor(m.cumulative)}`).join(' ');
  const zeroY = yFor(0);
  let cumSvg = `<svg class="chart-svg" viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg">`;
  cumSvg += `<line x1="${padL}" y1="${zeroY}" x2="${W-padR}" y2="${zeroY}" stroke="#dcd4c0" stroke-width="1"/>`;
  cumSvg += `<polyline points="${linePoints}" fill="none" stroke="#3a8f8c" stroke-width="2.5"/>`;
  monthlyCashflow.forEach((m,i)=>{
    cumSvg += `<circle cx="${xFor(i)}" cy="${yFor(m.cumulative)}" r="3" fill="#1b3a4b"/>`;
    if(i===0 || i===n-1 || i%Math.ceil(n/8)===0){
      cumSvg += `<text x="${xFor(i)}" y="${H-6}" class="chart-tooltip-label" text-anchor="middle">${escapeHtml(m.month)}</text>`;
    }
  });
  cumSvg += `<text x="4" y="${yFor(cumMax)+4}" class="chart-tooltip-label">${fmtMoney(cumMax)}</text>`;
  cumSvg += `<text x="4" y="${yFor(cumMin)+4}" class="chart-tooltip-label">${fmtMoney(cumMin)}</text>`;
  cumSvg += `</svg>`;
  cumEl.innerHTML = cumSvg;

  // ---- 每月淨結餘(長條圖) ----
  const netVals = monthlyCashflow.map(m=>m.net);
  const netMax = Math.max(1, ...netVals.map(Math.abs));
  const barZeroY = padT + (H-padT-padB)/2;
  const halfH = (H-padT-padB)/2;
  const barW = Math.min(28, (W-padL-padR)/n * 0.6);
  let barSvg = `<svg class="chart-svg" viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg">`;
  barSvg += `<line x1="${padL}" y1="${barZeroY}" x2="${W-padR}" y2="${barZeroY}" stroke="#dcd4c0" stroke-width="1"/>`;
  monthlyCashflow.forEach((m,i)=>{
    const cx = xFor(i);
    const h = Math.abs(m.net)/netMax*halfH;
    const y = m.net>=0 ? barZeroY-h : barZeroY;
    const color = m.net>=0 ? '#3a8f8c' : '#b5533f';
    barSvg += `<rect x="${cx-barW/2}" y="${y}" width="${barW}" height="${h}" fill="${color}" rx="2"/>`;
    if(i===0 || i===n-1 || i%Math.ceil(n/8)===0){
      barSvg += `<text x="${cx}" y="${H-6}" class="chart-tooltip-label" text-anchor="middle">${escapeHtml(m.month)}</text>`;
    }
  });
  barSvg += `</svg>`;
  barEl.innerHTML = barSvg;
}

function switchTab(name){
  document.getElementById('tab-alloc').style.display = (name==='alloc') ? '' : 'none';
  document.getElementById('tab-finance').style.display = (name==='finance') ? '' : 'none';
}

