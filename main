// 畫一個像飛機儀表板一樣的指針式儀表:紅/黃/綠三色區間 + 指針指向目前數值
// value/scaleMax 為 0~1+ 的比率(例如 0.92 代表 92%);zones 是 [{to:0.5,color:'red'},{to:0.9,color:'yellow'},{to:999,color:'green'}] 這種累加式的分界
function drawGaugeSVG(value, scaleMax, zones){
  const W = 220, H = 140, cx = 110, cy = 120, r = 90;
  const clampedValue = Math.max(0, Math.min(value, scaleMax));
  const toAngle = frac => 180 - Math.max(0,Math.min(frac,1))*180; // frac=0→180°(左) frac=1→0°(右)
  const polar = (angleDeg, radius) => {
    const rad = angleDeg * Math.PI/180;
    return { x: cx + radius*Math.cos(rad), y: cy - radius*Math.sin(rad) };
  };

  let svg = `<svg class="chart-svg" viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg">`;

  // 畫紅黃綠三色區間弧線
  let prevFrac = 0;
  zones.forEach(zone=>{
    const zoneFrac = Math.min(zone.to/scaleMax, 1);
    if(zoneFrac <= prevFrac) return;
    const startPt = polar(toAngle(prevFrac), r);
    const endPt = polar(toAngle(zoneFrac), r);
    svg += `<path d="M${startPt.x.toFixed(1)},${startPt.y.toFixed(1)} A${r},${r} 0 0 1 ${endPt.x.toFixed(1)},${endPt.y.toFixed(1)}" fill="none" stroke="${zone.color}" stroke-width="16" stroke-linecap="butt"/>`;
    prevFrac = zoneFrac;
  });

  // 指針
  const needleFrac = clampedValue/scaleMax;
  const needleAngle = toAngle(needleFrac);
  const needleTip = polar(needleAngle, r-22);
  svg += `<line x1="${cx}" y1="${cy}" x2="${needleTip.x.toFixed(1)}" y2="${needleTip.y.toFixed(1)}" stroke="#1b3a4b" stroke-width="4" stroke-linecap="round"/>`;
  svg += `<circle cx="${cx}" cy="${cy}" r="8" fill="#1b3a4b"/>`;

  svg += `</svg>`;
  return svg;
}

// 儀表通用的紅黃綠分界:0~50%=危險、50~90%=注意、90%以上=安全
const GAUGE_ZONES = [
  { to: 0.50, color: 'var(--red)',  status: '🔴 危險', statusColor: 'var(--red)' },
  { to: 0.90, color: 'var(--gold)', status: '🟡 注意', statusColor: 'var(--gold)' },
  { to: 999,  color: 'var(--teal)', status: '🟢 安全', statusColor: 'var(--teal)' }
];

function gaugeStatusFor(value){
  for(const zone of GAUGE_ZONES){
    if(value <= zone.to) return zone;
  }
  return GAUGE_ZONES[GAUGE_ZONES.length-1];
}

function renderGaugeBox(label, value){
  if(value === null || isNaN(value)){
    return `<div class="gauge-box">${drawGaugeSVG(0, 1.5, GAUGE_ZONES)}<div class="gauge-value">--</div><div class="gauge-label">${escapeHtml(label)}</div></div>`;
  }
  const zone = gaugeStatusFor(value);
  return `<div class="gauge-box">
    ${drawGaugeSVG(value, 1.5, GAUGE_ZONES)}
    <div class="gauge-value">${fmtPct(value)}</div>
    <div class="gauge-label">${escapeHtml(label)}</div>
    <div class="gauge-status" style="color:${zone.statusColor}">${zone.status}</div>
  </div>`;
}

function renderFI(){
  const fiSummary = document.getElementById('fiSummary');
  const fiBody = document.getElementById('fiTableBody');

  if(!monthlyCashflow.length && assetSnapshots.length < 2){
    fiSummary.innerHTML = '';
    document.getElementById('fiGaugeRow').innerHTML = '';
    fiBody.innerHTML = '<tr><td colspan="3" class="chart-empty">尚無現金流或資產快照資料,無法計算。請先完成現金流設定,或點下方「記錄本月快照」開始累積。</td></tr>';
    renderNetWorthChart();
    return;
  }

  // ---- 資產累積斜率:優先用「資產快照歷史」(真實),不足時退回現金流累積結餘(代理估算) ----
  let slope, slopeSource;
  if(assetSnapshots.length >= 2){
    const sn = assetSnapshots.length;
    const sxs = assetSnapshots.map((_,i)=>i);
    const sys = assetSnapshots.map(s=>s.total);
    const sSumX = sxs.reduce((a,b)=>a+b,0);
    const sSumY = sys.reduce((a,b)=>a+b,0);
    const sSumXY = sxs.reduce((s,x,i)=>s+x*sys[i],0);
    const sSumX2 = sxs.reduce((s,x)=>s+x*x,0);
    const sDenom = (sn*sSumX2 - sSumX*sSumX);
    slope = sDenom!==0 ? (sn*sSumXY - sSumX*sSumY)/sDenom : 0;
    slopeSource = '真實(依資產快照)';
  } else {
    const n = monthlyCashflow.length;
    const xs = monthlyCashflow.map((_,i)=>i);
    const ys = monthlyCashflow.map(m=>m.cumulative);
    const sumX = xs.reduce((a,b)=>a+b,0);
    const sumY = ys.reduce((a,b)=>a+b,0);
    const sumXY = xs.reduce((s,x,i)=>s+x*ys[i],0);
    const sumX2 = xs.reduce((s,x)=>s+x*x,0);
    const denom = (n*sumX2 - sumX*sumX);
    slope = denom!==0 ? (n*sumXY - sumX*sumY)/denom : 0;
    slopeSource = '代理估算(依現金流,尚無足夠快照)';
  }
  const slopeAnnual = slope*12;
  const slopePctOfAssets = totalAssetValueGlobal>0 ? slopeAnnual/totalAssetValueGlobal : null;

  renderNetWorthChart();

  // ---- 月均支出 / 月均淨結餘 / 月均收入 ----
  const cfN = monthlyCashflow.length || 1;
  const avgExpense = monthlyCashflow.reduce((s,m)=>s+m.expense,0)/cfN;
  const avgNet = monthlyCashflow.reduce((s,m)=>s+m.net,0)/cfN;
  const avgIncome = monthlyCashflow.reduce((s,m)=>s+m.income,0)/cfN;

  const fireByExpense = (avgExpense*12)/0.04;
  const fireByNet = (avgNet*12)/0.04;

  const ratioByExpense = fireByExpense>0 ? totalAssetValueGlobal/fireByExpense : null;
  const ratioByNet = fireByNet>0 ? totalAssetValueGlobal/fireByNet : null;

  // ---- 所得替代率:資產可提領年金(4%) ÷ 年化收入 ----
  const annualIncome = avgIncome*12;
  const sustainableAnnualWithdrawal = totalAssetValueGlobal*0.04;
  const incomeReplacementRatio = annualIncome>0 ? sustainableAnnualWithdrawal/annualIncome : null;

  document.getElementById('fiGaugeRow').innerHTML =
    renderGaugeBox('財富自由比率(依支出)', ratioByExpense) +
    renderGaugeBox('所得替代率', incomeReplacementRatio);

  fiSummary.innerHTML = `
    <div class="summary-box"><div class="label">資產累積斜率(每月)· ${escapeHtml(slopeSource)}</div><div class="value small ${slope>=0?'pos':'neg'}">${slope>=0?'+':''}NT$${fmtMoney(slope)}/月</div></div>
    <div class="summary-box"><div class="label">年化成長速度(相對目前總資產)</div><div class="value small ${slopePctOfAssets>=0?'pos':'neg'}">${slopePctOfAssets!==null?fmtPct(slopePctOfAssets):'--'}/年</div></div>
    <div class="summary-box"><div class="label">目前總資產</div><div class="value">NT$${fmtMoney(totalAssetValueGlobal)}</div></div>
  `;

  function fiRow(label, expenseVal, netVal, isPct){
    const fmt = isPct ? (v=> v===null?'--':fmtPct(v)) : (v=> v===null?'--':'NT$'+fmtMoney(v));
    return `<tr><td class="name">${label}</td><td>${fmt(expenseVal)}</td><td>${fmt(netVal)}</td></tr>`;
  }

  fiBody.innerHTML =
    fiRow('月均金額(支出/淨結餘)', avgExpense, avgNet, false) +
    fiRow('年化金額 ×12', avgExpense*12, avgNet*12, false) +
    fiRow('FIRE 目標資產(÷4%)', fireByExpense, fireByNet, false) +
    fiRow('財富自由比率(目前總資產÷FIRE目標)', ratioByExpense, ratioByNet, true);
}


function renderNetWorthChart(){
  const el = document.getElementById('netWorthChart');
  if(!el) return;
  if(assetSnapshots.length < 2){
    el.innerHTML = `<div class="chart-empty">目前有 ${assetSnapshots.length} 筆快照,至少需要 2 筆才能畫出趨勢線。每月點一次「記錄本月快照」持續累積即可。</div>`;
    return;
  }
  const W = 760, H = 180, padL = 55, padR = 15, padT = 15, padB = 25;
  const vals = assetSnapshots.map(s=>s.total);
  const vMin = Math.min(...vals), vMax = Math.max(...vals);
  const vRange = (vMax - vMin) || 1;
  const n = assetSnapshots.length;
  const xStep = n>1 ? (W-padL-padR)/(n-1) : 0;
  const yFor = v => padT + (H-padT-padB) * (1 - (v-vMin)/vRange);
  const xFor = i => padL + xStep*i;

  let points = assetSnapshots.map((s,i)=>`${xFor(i)},${yFor(s.total)}`).join(' ');
  let svg = `<svg class="chart-svg" viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg">`;
  svg += `<polyline points="${points}" fill="none" stroke="#c99a3c" stroke-width="2.5"/>`;
  assetSnapshots.forEach((s,i)=>{
    svg += `<circle cx="${xFor(i)}" cy="${yFor(s.total)}" r="3" fill="#1b3a4b"/>`;
    if(i===0 || i===n-1 || i%Math.ceil(n/8)===0){
      svg += `<text x="${xFor(i)}" y="${H-6}" class="chart-tooltip-label" text-anchor="middle">${escapeHtml(s.date)}</text>`;
    }
  });
  svg += `<text x="4" y="${yFor(vMax)+4}" class="chart-tooltip-label">${fmtMoney(vMax)}</text>`;
  svg += `<text x="4" y="${yFor(vMin)+4}" class="chart-tooltip-label">${fmtMoney(vMin)}</text>`;
  svg += `</svg>`;
  el.innerHTML = svg;
}

async function recordSnapshot(){
  const statusEl = document.getElementById('snapshotStatus');
  if(!SHEET_WEBAPP_URL || !SECRET_TOKEN){
    statusEl.textContent = '尚未設定 Sheet 網址或安全性權杖,請先完成交易登記分頁裡的設定教學。';
    statusEl.style.color = 'var(--red)';
    return;
  }
  const stockValue = holdings.filter(h=>h.category==='股票').reduce((s,h)=>s+(Number(h.value)||0),0);
  const bondValue = holdings.filter(h=>h.category==='債券').reduce((s,h)=>s+(Number(h.value)||0),0);
  const today = new Date();
  const dateStr = today.toISOString().slice(0,10);

  if(!confirm(`確定要記錄今天(${dateStr})的資產快照嗎?\n總資產:NT$${fmtMoney(totalAssetValueGlobal)}\n這筆紀錄之後無法從這裡刪除,只能到 Sheet 裡手動刪。`)){
    return;
  }

  const payload = {
    type: 'snapshot',
    token: SECRET_TOKEN,
    date: dateStr,
    total: totalAssetValueGlobal,
    stock: stockValue,
    bond: bondValue,
    cash: cashValue
  };
  try{
    await fetch(SHEET_WEBAPP_URL, { method:'POST', mode:'no-cors', body: JSON.stringify(payload) });
    statusEl.textContent = `已送出 ${dateStr} 的快照(因跨網域限制無法100%確認寫入成功,建議偶爾回 Sheet 確認)。`;
    statusEl.style.color = 'var(--teal)';
    setTimeout(loadAll, 1500);
  }catch(err){
    statusEl.textContent = '送出失敗:'+err.message;
    statusEl.style.color = 'var(--red)';
  }
}


async function loadAll(){
  document.getElementById('appsScriptCode').textContent = APPS_SCRIPT_CODE;
  await loadTargets();
  if(SHEET_WEBAPP_URL){
    try{
      const url = SHEET_WEBAPP_URL + '?token=' + encodeURIComponent(SECRET_TOKEN);
      const res = await fetch(url);
      const json = await res.json();
      if(json.error){
        console.error('Sheet 拒絕存取:', json.error);
        return;
      }
      holdings = (json.holdings||[]).map(h=>({
        ...h, qty:Number(h.qty)||0, cost:Number(h.cost)||0,
        price:Number(h.price)||0, value:Number(h.value)||0,
        pnl:Number(h.pnl)||0, returnPct: h.returnPct===''||h.returnPct===undefined? null: Number(h.returnPct)
      }));
      cashValue = Number(json.cash)||0;
      monthlyCashflow = (json.monthlyCashflow||[]).map(m=>({
        month: m.month, income:Number(m.income)||0, expense:Number(m.expense)||0,
        net:Number(m.net)||0, cumulative:Number(m.cumulative)||0
      }));
      assetSnapshots = (json.assetSnapshots||[]).map(s=>({
        date: s.date, total:Number(s.total)||0, stock:Number(s.stock)||0,
        bond:Number(s.bond)||0, cash:Number(s.cash)||0
      }));
      transactions = (json.transactions||[]).map(t=>({
        row: Number(t.row), date: t.date, ticker: t.ticker,
        category: t.category, sub: t.sub, qty: Number(t.qty)||0
      }));
    }catch(err){
      console.error('讀取 Sheet 失敗', err);
    }
  }
  render();
  renderCashflow();
  renderFI();
  renderTxList();
}

document.getElementById('txDate').valueAsDate = new Date();
updateSubOptions();
document.getElementById('throttleDesc').textContent = throttleDescription(70);
updateTokenBanner();
loadAll();
</script>
